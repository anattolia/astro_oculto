---
import Layout from "../layouts/Layout.astro";
// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import piscis1 from "../assets/piscis/piscis.png";
import piscis2 from "../assets/piscis/piscis2.png";
import caballo from "../assets/piscis/caballo.png";
---

<Layout>
  <section class="container">
    <div class="info">
      <div>
        <h1>Piscis</h1>
        <h2>
          {lugares.features[44]?.properties.añoInicio} - {
            lugares.features[44]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[44]?.properties.genero}</h2>
        <p class="direccion">{lugares.features[44]?.properties.direccion}</p>
        <p class="direccion">{lugares.features[44]?.properties.barrio}</p>
        <p>{lugares.features[44]?.properties.descripcion}</p>

        Referencias:
        <ul>
          {
            lugares.features[44]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <img class="textos" src={piscis1.src} alt="Texto sobre Piscis" />
      <img class="textos" src={piscis2.src} alt="Texto" />
    </div>
    <img id="caballo" src={caballo.src} alt="Caballo blanco" />
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>
</Layout>

<script></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

  .container {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    padding: 2em;
    background-color: #eff4d2b3;
    background: linear-gradient(284deg, #f6e1c5 0%, #ff9a9a 10%, #ffeeee 60%)
      border-box;
    color: black;
    font-family: system-ui;
    min-height: 100vh;
  }

  h1 {
    font-size: 4em;
    font-family: "Ga Maamli", sans-serif;
    font-weight: 400;
    font-style: normal;
    color: #191818e0;
    text-align: center;
    margin: 0;
  }

  h2 {
    margin: 0;
    font-weight: normal;
    color: #111827;
    font-size: 20px;
    text-align: center;
  }

  p {
    color: #111827;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
    margin: 1.5em 0;
  }

  img {
    width: 10vw;
  }

  a,
  a:visited,
  a:active {
    color: #474747d0;
    text-decoration: none;
    padding: 2px 7px;
    border-radius: 5px;
    font-family: monospace;
  }

  a:hover {
    color: rgba(255, 255, 255);
  }

  .info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    justify-content: center;
    gap: 6em;
    padding: 1em 7em 1em 5em;
  }
  .direccion {
    text-align: center;
    font-size: 0.8em;
    line-height: 0.5em;
    margin: 0.7em;
  }

  .boton {
    color: #474747d0;
    text-decoration: none;
    background: #e8c742b5;
    padding: 6px 6px;
    border-radius: 5px;
    font-family: system-ui;
    font-size: 0.6em;
    position: fixed;
    bottom: 3vh;
    right: 2vw;
    box-shadow: 2px 2px 2px #242424c9;
  }

  #contenedorAV {
    display: flex;
    justify-content: center;
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding-top: 2em;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2em;

    img {
      width: 50%;
      height: auto;
    }

    img {
      width: 50vw;
      height: auto;
    }
    .video {
      width: 40%;
      height: auto;
      aspect-ratio: 16/9;
    }
  }

  #caballo {
    opacity: 0.5;
    position: fixed;
    width: 14vw;
    bottom: 0vh;
    right: 0vw;
    mix-blend-mode: color-burn;
  }
  #contenedorPapeles {
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding: 2em 6em;
  }

  @media screen and (max-width: 450px) {
    h1 {
      margin-top: 0px;
    }

    .container {
      padding: 3em;
      width: 100vw;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em;
    }

    #contenedorAV {
      img {
        width: 70%;
      }
    }
  }

  @media screen and (min-width: 450px) and (max-width: 1100px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 80vh;
      width: auto;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em 2em;
    }
    #contenedorAV {
    }
  }
</style>
