---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import tvg1 from "../assets/tvg/tvg_jenny_rojas_fb.jpg";
import boleta1 from "../assets/tvg/boleta_tvg.jpeg";
import boleta2 from "../assets/tvg/boleta_tvg2.jpeg";
import tvg2 from "../assets/tvg/te_veo_grave.jpg";
import estadosAlt from "../assets/tvg/tvg_estados_alt.png";
---

<Layout>
  <section class="container">
    <div class="info">
      {/* <img src={tvg1.src} alt="T.V.G. en Bogotá" /> */}
      <div>
        <h1>Antifaz</h1>
        <h2>
          {lugares.features[2]?.properties.añoInicio} - {
            lugares.features[2]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[2]?.properties.genero}</h2>
        <p class="direccion">{lugares.features[2]?.properties.direccion}</p>
        <p class="direccion">{lugares.features[2]?.properties.barrio}</p>
        <p>{lugares.features[2]?.properties.descripcion}</p>

        Referencias:
        <ul>
          {
            lugares.features[2]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <div class="elemento">
        <p>Canciones de Antifaz</p>
        <iframe
          class="video"
          src="https://www.youtube.com/embed/videoseries?si=jlTglA0wZFxCOIRi&list=PLhakzgpKngU2cHC4wy_CXxcXNUprs4ZZO"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      {
        /*<img src={boleta1.src} alt="Boleta T.V.G." />
      <img src={boleta2.src} alt="Boleta T.V.G." />
      <img src={estadosAlt.src} alt="Estados Alterados en T.V.G." />
      <img src={tvg2.src} alt="T.V.G. en Bogotá" />*/
      }
    </div>
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>
</Layout>

<script></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

  .container {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    padding: 2em;
    background-color: #eff4d2b3;
    background: linear-gradient(284deg, #f6e1c5 0%, #d7e1ff 10%, #ffc8c8 60%)
      border-box;
    color: black;
    font-family: system-ui;
    min-height: 100vh;
  }

  h1 {
    font-size: 4em;
    font-family: "Ga Maamli", sans-serif;
    font-weight: 400;
    font-style: normal;
    color: #191818e0;
    text-align: center;
    margin: 0;
  }

  h2 {
    margin: 0;
    font-weight: normal;
    color: #111827;
    font-size: 20px;
    text-align: center;
  }

  p {
    color: #111827;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
    margin: 1.5em 0;
  }

  img {
    height: 85vh;
  }

  a,
  a:visited,
  a:active {
    color: #474747d0;
    text-decoration: none;
    padding: 2px 7px;
    border-radius: 5px;
    font-family: monospace;
  }

  a:hover {
    color: rgba(255, 255, 255);
  }

  .info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    justify-content: center;
    gap: 6em;
    padding: 1em 7em 1em 5em;
  }

  .direccion {
    text-align: center;
    font-size: 0.8em;
    line-height: 0.5em;
    margin: 0.7em;
  }

  #contenedorAV {
    display: flex;
    justify-content: center;
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding-top: 2em;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2em;

    img {
      width: 20%;
      height: auto;
    }

    .elemento {
      width: 40%;
      font-family: monospace;
      font-size: 0.9em;

      p {
        margin: 0;
      }
    }

    .video {
      height: auto;
      aspect-ratio: 16/9;
      margin: 0;
    }
  }

  #contenedorPapeles {
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding: 2em 6em;
  }

  @media screen and (max-width: 450px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 70vh;
      width: auto;
    }
    .container {
      padding: 3em;
      width: 100vw;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em;
    }
    .boton {
      bottom: 10px;
      right: 15px;
    }
    #contenedorAV {
      img {
        width: 40%;
      }
    }
  }

  @media screen and (min-width: 450px) and (max-width: 1100px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 80vh;
      width: auto;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em 2em;
    }
    #contenedorAV {
      img {
        width: 32%;
      }
    }
  }
</style>
