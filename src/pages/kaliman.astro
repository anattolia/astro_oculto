---
import Layout from "../layouts/Layout.astro";
// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import kaliman2 from "../assets/kaliman/kaliman2_rockbogotano_ig.png";
import kaliman3 from "../assets/kaliman/kaliman3.jpeg";
import kaliman4 from "../assets/kaliman/kaliman4.jpeg";
import kaliman5 from "../assets/kaliman/kaliman5.jpeg";
import kaliman6 from "../assets/kaliman/kaliman6.jpeg";
import kaliman7 from "../assets/kaliman/kaliman7.jpeg";
import kaliman8 from "../assets/kaliman/kaliman8.jpeg";
import kaliman9 from "../assets/kaliman/kaliman9.jpeg";
---

<Layout>
  <section class="container">
    <div class="info">
      <img src={kaliman2.src} alt="T.V.G. en Bogotá" />
      <div>
        <h1>Kaliman</h1>
        <h2>
          {lugares.features[27]?.properties.añoInicio} - {
            lugares.features[27]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[27]?.properties.genero}</h2>
        <p class="direccion">{lugares.features[27]?.properties.direccion}</p>
        <p class="direccion">{lugares.features[27]?.properties.barrio}</p>
        <p>{lugares.features[27]?.properties.descripcion}</p>

        Referencias:
        <ul>
          {
            lugares.features[27]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <img src={kaliman3.src} alt="Flyers Kaliman" />
      <img src={kaliman4.src} alt="Flyers Kaliman" />
      <img src={kaliman5.src} alt="Flyers Kaliman" />
      <img src={kaliman7.src} alt="Flyers Kaliman" />
      <img src={kaliman6.src} alt="Flyers Kaliman" />
      <img src={kaliman8.src} alt="Flyers Kaliman" />
      <img src={kaliman9.src} alt="Flyers Kaliman" />
    </div>
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>

  <script></script>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

    .container {
      font-family:
        Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
        sans-serif;
      padding: 2em;
      background-color: #eff4d2b3;
      background: linear-gradient(284deg, #f6e1c5 0%, #d7e1ff 10%, #ffc8c8 60%)
        border-box;
      color: black;
      font-family: system-ui;
      min-height: 100vh;
    }

    h1 {
      font-size: 4em;
      font-family: "Ga Maamli", sans-serif;
      font-weight: 400;
      font-style: normal;
      color: #191818e0;
      text-align: center;
      margin: 0;
    }

    h2 {
      margin: 0;
      font-weight: normal;
      color: #111827;
      font-size: 20px;
      text-align: center;
    }

    p {
      color: #111827;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.006em;
      margin: 1.5em 0;
    }

    img {
      width: 30vw;
    }

    a,
    a:visited,
    a:active {
      color: #474747d0;
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 5px;
      font-family: monospace;
    }

    a:hover {
      color: rgba(255, 255, 255);
    }

    .info {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 6em;
      padding: 1em 7em 1em 5em;
    }

    .direccion {
      text-align: center;
      font-size: 0.8em;
      line-height: 0.5em;
      margin: 0.7em;
    }

    .boton {
      color: #474747d0;
      text-decoration: none;
      background: #eef4ce84;
      padding: 6px 6px;
      border-radius: 5px;
      font-family: system-ui;
      font-size: 0.6em;
      position: fixed;
      bottom: 3vh;
      right: 2vw;
      box-shadow: 2px 2px 2px #242424c9;
    }

    #contenedorAV {
      display: flex;
      justify-content: center;
      margin-top: 2em;
      border-top: 1px dashed #000;
      padding-top: 2em;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 2em;

      img {
        width: 20%;
        height: auto;
      }

      .elemento {
        width: 40%;
        font-family: monospace;
        font-size: 0.9em;

        p {
          margin: 0;
        }
      }

      .video {
        height: auto;
        aspect-ratio: 16/9;
        margin: 0;
      }
    }

    #contenedorPapeles {
      margin-top: 2em;
      border-top: 1px dashed #000;
      padding: 2em 6em;
    }

    @media screen and (max-width: 450px) {
      h1 {
        margin-top: 0px;
      }
      img {
        height: 70vh;
        width: auto;
      }
      .container {
        padding: 3em;
        width: 100vw;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        justify-content: center;
        gap: 2em;
        padding: 0em;
      }

      #contenedorAV {
        img {
          width: 40%;
        }
      }
    }

    @media screen and (min-width: 450px) and (max-width: 1100px) {
      h1 {
        margin-top: 0px;
      }
      img {
        height: 80vh;
        width: auto;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        justify-content: center;
        gap: 2em;
        padding: 0em 2em;
      }
      #contenedorAV {
        img {
          width: 32%;
        }
      }
    }
  </style>
</Layout>
