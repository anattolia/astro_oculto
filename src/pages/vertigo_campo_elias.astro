---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import vertigo1 from "../assets/vertigo/vertigo_campo_elias_je_pm_fb.jpg";
import vertigo2 from "../assets/vertigo/vertigo_campo_elias_je_pm_fb2.jpg";
---

<Layout>
  <section class="container">
    <div class="info">
      <img src={vertigo1.src} alt="Flyer Vértigo Campo Elías" />
      <div>
        <h1>Vértigo Campo Elías</h1>
        <h2>
          {lugares.features[58]?.properties.añoInicio} - {
            lugares.features[58]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[58]?.properties.genero}</h2>
        <p class="direccion">{lugares.features[58]?.properties.direccion}</p>
        <p class="direccion">{lugares.features[58]?.properties.barrio}</p>
        <p>{lugares.features[58]?.properties.descripcion}</p> Referencias:
        <ul>
          {
            lugares.features[58]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <iframe
        class="video"
        src="https://www.youtube.com/embed/pqQ_HnCHqK0?si=ZtoJ895Sr4-4cG8F"
        title="YouTube video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
      <img src={vertigo2.src} alt="Flyers Vértigo Campo Elías" />
    </div>
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>
</Layout>

<script></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

  .container {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    padding: 2em;
    background-image: url(https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Fwww.porcuatrocuartos.com%2Fwp-content%2Fuploads%2F2013%2F01%2FIMG_9264-copy.jpg&f=1&nofb=1&ipt=92cede3…&ipo=images);
    backdrop-filter: unset;
    background-color: #efc6ff;
    background-blend-mode: lighten;
    background-repeat: repeat;
    color: black;
    font-family: system-ui;
    min-height: 100vh;
  }

  h1 {
    font-size: 4em;
    font-family: "Ga Maamli", sans-serif;
    font-weight: 400;
    font-style: normal;
    color: #191818e0;
    text-align: center;
    margin: 0;
  }

  h2 {
    margin: 0;
    font-weight: normal;
    color: #111827;
    font-size: 20px;
    text-align: center;
  }

  p {
    color: #111827;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
    margin: 1.5em 0;
  }

  img {
    height: 80vh;
  }

  a,
  a:visited,
  a:active {
    color: #474747d0;
    text-decoration: none;
    padding: 2px 7px;
    border-radius: 5px;
    font-family: monospace;
  }

  a:hover {
    color: rgba(255, 255, 255);
  }

  .info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    justify-content: center;
    gap: 6em;
    padding: 1em 7em 1em 5em;
  }

  .direccion {
    text-align: center;
    font-size: 0.8em;
    line-height: 0.5em;
    margin: 0.7em;
  }

  #contenedorAV {
    display: flex;
    justify-content: center;
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding-top: 2em;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2em;

    img {
      width: 20%;
      height: auto;
    }

    .video {
      width: 40%;
      height: auto;
      aspect-ratio: 16/9;
    }
  }

  #contenedorPapeles {
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding: 2em 6em;
  }

  @media screen and (max-width: 450px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 70vh;
      width: auto;
    }
    .container {
      padding: 3em;
      width: 100vw;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em;
    }

    .boton {
    }

    #contenedorAV {
      img {
        width: 40%;
      }
    }
  }

  @media screen and (min-width: 450px) and (max-width: 1100px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 80vh;
      width: auto;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em 2em;
    }
    #contenedorAV {
      img {
        width: 32%;
      }
    }
  }
</style>
