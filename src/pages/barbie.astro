---
import Layout from "../layouts/Layout.astro";
// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import barbie0 from "../assets/barbie/barbie.jpg";
import barbie1 from "../assets/barbie/barbie1.jpg";
import barbie2 from "../assets/barbie/barbie2.jpg";
import barbie3 from "../assets/barbie/barbie3.jpg";
import barbie4 from "../assets/barbie/barbie4.jpg";
import barbie5 from "../assets/barbie/barbie_adriana_puyana_fb.jpg";
import barbie6 from "../assets/barbie/barbie6.jpg";
import barbie7 from "../assets/barbie/barbie7.jpg";
import barbie8 from "../assets/barbie/barbie8.jpg";
import barbie9 from "../assets/barbie/barbie9.jpg";
import barbie10 from "../assets/barbie/barbie10.jpg";
import barbie11 from "../assets/barbie/barbie11.jpg";
import barbie12 from "../assets/barbie/barbie12.jpg";
import barbie13 from "../assets/barbie/barbie13.jpg";
import barbie14 from "../assets/barbie/barbie14.jpg";
import barbie15 from "../assets/barbie/barbie15.jpg";
import barbie16 from "../assets/barbie/barbie16.jpg";
---

<Layout>
  <section class="container">
    <div class="info">
      <img src={barbie15.src} alt="Flyer Barbie" />

      <div>
        <h1>Barbie</h1>
        <h2>
          {lugares.features[8]?.properties.añoInicio} - {
            lugares.features[8]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[8]?.properties.genero}</h2>
        <p class="direccion">{lugares.features[8]?.properties.direccion}</p>
        <p class="direccion">{lugares.features[8]?.properties.barrio}</p>
        <p>{lugares.features[8]?.properties.descripcion}</p>

        Referencias:
        <ul>
          {
            lugares.features[8]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <img src={barbie8.src} alt="Flyer Barbie" />
      <img src={barbie1.src} alt="Flyer Barbie" />
      <img src={barbie2.src} alt="Flyer Barbie" />
      <img src={barbie3.src} alt="Flyer Barbie" />
      <img src={barbie4.src} alt="Flyer Barbie" />
      <img src={barbie5.src} alt="Flyer Barbie" />
      <img src={barbie6.src} alt="Flyer Barbie" />
      <img src={barbie7.src} alt="Flyer Barbie" />
      <img src={barbie9.src} alt="Flyer Barbie" />
      <img src={barbie10.src} alt="Flyer Barbie" />
      <img src={barbie11.src} alt="Flyer Barbie" />
      <img src={barbie12.src} alt="Flyer Barbie" />
      <img src={barbie14.src} alt="Flyer Barbie" />
      <img src={barbie13.src} alt="Flyer Barbie" />
      <img src={barbie16.src} alt="Flyer Barbie" />
      <img src={barbie0.src} alt="Flyer Barbie" />
    </div>
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>
</Layout>

<script></script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

  .container {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    padding: 2em;
    background-color: #eff4d2b3;
    background: linear-gradient(284deg, #f6e1c5 0%, #d7e1ff 10%, #ffc8c8 60%)
      border-box;
    color: black;
    font-family: system-ui;
    min-height: 100vh;
  }

  h1 {
    font-size: 4em;
    font-family: "Ga Maamli", sans-serif;
    font-weight: 400;
    font-style: normal;
    color: #191818e0;
    text-align: center;
    margin: 0;
  }

  h2 {
    margin: 0;
    font-weight: normal;
    color: #111827;
    font-size: 20px;
    text-align: center;
  }

  p {
    color: #111827;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
    margin: 1.5em 0;
  }

  img {
    height: 80vh;
  }

  a,
  a:visited,
  a:active {
    color: #474747d0;
    text-decoration: none;
    padding: 2px 7px;
    border-radius: 5px;
    font-family: monospace;
  }

  a:hover {
    color: rgba(255, 255, 255);
  }

  .info {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    justify-content: center;
    gap: 6em;
    padding: 1em 7em 1em 5em;
  }

  .direccion {
    text-align: center;
    font-size: 0.8em;
    line-height: 0.5em;
    margin: 0.7em;
  }

  .boton {
    color: #474747d0;
    text-decoration: none;
    background: #e8c742b5;
    padding: 6px 6px;
    border-radius: 5px;
    font-family: system-ui;
    font-size: 0.6em;
    position: fixed;
    bottom: 3vh;
    right: 2vw;
    box-shadow: 2px 2px 2px #242424c9;
  }

  #contenedorAV {
    display: flex;
    justify-content: center;
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding-top: 2em;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2em;

    img {
      width: 20%;
      height: auto;
    }

    .video {
      width: 40%;
      height: auto;
      aspect-ratio: 16/9;
    }
  }

  #contenedorPapeles {
    margin-top: 2em;
    border-top: 1px dashed #000;
    padding: 2em 6em;
  }

  @media screen and (max-width: 450px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 70vh;
      width: auto;
    }
    .container {
      padding: 3em;
      width: 100vw;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em;
    }

    #contenedorAV {
      img {
        width: 40%;
      }
    }
  }

  @media screen and (min-width: 450px) and (max-width: 1100px) {
    h1 {
      margin-top: 0px;
    }
    img {
      height: 80vh;
      width: auto;
    }
    .info {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 2em;
      padding: 0em 2em;
    }
    #contenedorAV {
      img {
        width: 32%;
      }
    }
  }
</style>
