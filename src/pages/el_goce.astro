---
import Layout from "../layouts/Layout.astro";
// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import gustavoBarra from "../assets/el_goce/gustavo_barra.jpg";
import tere from "../assets/el_goce/teresita_cl.png";
import yemaya from "../assets/el_goce/yemaya_bn.jpg";
import goce from "../assets/el_goce/6.jpg";

// Textos
import pamuk from "../assets/el_goce/2012_Pamuk.pdf";
import zapata from "../assets/el_goce/2014_Zapata.pdf";
import oe from "../assets/el_goce/2015_Oe.pdf";
import rulfo from "../assets/el_goce/2016_Rulfo.pdf";
---

<Layout>
  <section class="container">
    <div class="info">
      <img src={gustavoBarra.src} alt="Gustavo Bustamante en El Goce" />
      <div>
        <h1>El Goce</h1>
        <h2>
          {lugares.features[18]?.properties.añoInicio} - {
            lugares.features[18]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[18]?.properties.genero}</h2>
        <p>{lugares.features[18]?.properties.descripcion}</p>

        Referencias:
        <ul>
          {
            lugares.features[18]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <img src={yemaya.src} alt="Yemaya en El Goce" />
      <img src={goce.src} alt="El Goce" />
      <img src={tere.src} alt="Teresita en El Goce" />
      <iframe
        class="video"
        src="https://www.youtube.com/embed/kqr42pf_l4M?si=8zBwDBZfWQtYsqhk"
        title="YouTube video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
    <div id="contenedorPapeles">
      <h3>Algunos de Los Papeles del Goce</h3>
      <ul>
        <li>
          <a href={pamuk} target="_blank" rel="noopener noreferrer">
            2012: 'Los objetos viajan por rutas misteriosas', Orhan Pamuk
          </a>
        </li>
        <li>
          <a href={zapata} target="_blank" rel="noopener noreferrer">
            2014: 'Zapata y la revolución mexicana', John Womack
          </a>
        </li>
        <li>
          <a href={oe} target="_blank" rel="noopener noreferrer">
            2015: 'El Jardón de los Oé', Juan Forn
          </a>
        </li>
        <li>
          <a href={rulfo} target="_blank" rel="noopener noreferrer">
            2016: 'Entrevista a Pedro Páramo'
          </a>
        </li>
      </ul>
    </div>
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>

  <script></script>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

    .container {
      font-family:
        Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
        sans-serif;
      padding: 2em;
      background-color: #eff4d2b3;
      background: linear-gradient(284deg, #f6e1c5 0%, #d7e1ff 10%, #ffc8c8 60%)
        border-box;
      color: black;
      font-family: system-ui;
      min-height: 100vh;
    }

    h1 {
      font-size: 4em;
      font-family: "Ga Maamli", sans-serif;
      font-weight: 400;
      font-style: normal;
      color: #191818e0;
      text-align: center;
      margin: 0;
    }

    h2 {
      margin: 0;
      font-weight: normal;
      color: #111827;
      font-size: 20px;
      text-align: center;
    }

    p {
      color: #111827;
      font-size: 1em;
      line-height: 24px;
      letter-spacing: -0.006em;
      margin: 1.5em 0;
    }

    img {
      height: 85vh;
    }

    a,
    a:visited,
    a:active {
      color: #474747d0;
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 5px;
      font-family: monospace;
    }

    a:hover {
      color: rgba(255, 255, 255);
    }

    .info {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 6em;
      padding: 1em 7em 1em 5em;
    }

    .boton {
      color: #474747d0;
      text-decoration: none;
      background: #eef4ce84;
      padding: 6px 6px;
      border-radius: 5px;
      font-family: system-ui;
      font-size: 0.6em;
      position: fixed;
      bottom: 3vh;
      right: 2vw;
      box-shadow: 2px 2px 2px #242424c9;
    }

    #contenedorAV {
      display: flex;
      justify-content: center;
      margin-top: 2em;
      border-top: 1px dashed #000;
      padding-top: 2em;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 2em;

      img {
        width: 40%;
        height: auto;
      }

      .video {
        width: 40%;
        height: auto;
        aspect-ratio: 16/9;
      }
    }

    #contenedorPapeles {
      margin-top: 2em;
      border-top: 1px dashed #000;
      padding: 2em 6em;
    }

    @media screen and (max-width: 450px) {
      h1 {
        margin-top: 0px;
      }
      img {
        height: 70vh;
        width: auto;
      }
      .container {
        padding: 3em;
        width: 100vw;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        justify-content: center;
        gap: 2em;
        padding: 0em;
      }

      #contenedorPapeles {
        padding: 0;
      }
    }

    @media screen and (min-width: 450px) and (max-width: 1100px) {
      h1 {
        margin-top: 0px;
      }
      img {
        height: 80vh;
        width: auto;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        justify-content: center;
        gap: 2em;
        padding: 0em 2em;
      }
    }
  </style>
</Layout>
