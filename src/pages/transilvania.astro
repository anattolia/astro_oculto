---
import Layout from "../layouts/Layout.astro";
// Importar lista de lugares
import { lugares } from "../data/lugares.js";

// Imágenes
import puerta from "../assets/transilvania/puerta.jpg";
import transilvana1 from "../assets/transilvania/transilvania_adriana_puyana_fb1.jpg";
import transilvana2 from "../assets/transilvania/transilvania_adriana_puyana_fb2.jpg";
import transilvana3 from "../assets/transilvania/transilvania_camilo_andres_torres_fb.jpg";
import transilvana4 from "../assets/transilvania/transilvania_camilo_andres_torres_fb2.jpg";
import transilvana5 from "../assets/transilvania/transilvania_ney_romero_patarroyo_fb.jpg";
import transilvana6 from "../assets/transilvania/transilvania_ney_romero_patarroyo_fb2_1.jpg";
import transilvana7 from "../assets/transilvania/transilvania_ney_romero_patarroyo_fb3.jpg";
import transilvana8 from "../assets/transilvania/transilvania_ney_romero_patarroyo_fb2_2.jpg";
---

<Layout>
  <section class="container">
    <div class="info">
      <img src={puerta.src} alt="Puerta de Transilvania" />
      <div>
        <h1>Transilvania</h1>
        <h2>
          {lugares.features[54]?.properties.añoInicio} - {
            lugares.features[54]?.properties.añoFin
          }
        </h2>
        <h2>{lugares.features[54]?.properties.genero}</h2>
        <p class="direccion">{lugares.features[54]?.properties.direccion}</p>
        <p class="direccion">{lugares.features[54]?.properties.barrio}</p>
        <p>{lugares.features[54]?.properties.descripcion}</p>

        Referencias:
        <ul>
          {
            lugares.features[54]?.properties.links.map((data) => (
              <li>
                <a href={data.enlace} target="_blank" rel="noopener noreferrer">
                  {data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div id="contenedorAV">
      <img src={transilvana2.src} alt="Flyer Transilvania" />
      <img src={transilvana1.src} alt="Flyer Transilvania" />
      <img src={transilvana4.src} alt="Flyer Transilvania" />
      <img src={transilvana8.src} alt="Flyer Aterciopelados y 1280 Almas" />
      <img src={transilvana6.src} alt="Flyer Aterciopelados" />
      <img src={transilvana7.src} alt="Flyer Caifanes" />
      <img src={transilvana3.src} alt="Flyer Transilvania" />
      <img src={transilvana5.src} alt="Flyer Transilvania" />
    </div>
    <a class="boton" href="../ciudad">volver al mapa</a>
  </section>

  <script></script>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Ga+Maamli&display=swap");

    .container {
      font-family:
        Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
        sans-serif;
      padding: 2em;
      background-color: #c2b6e3b3;
      /* background: linear-gradient(284deg, #f6e1c5 0%, #d7e1ff 10%, #ffc8c8 60%)
        border-box;*/
      color: black;
      font-family: system-ui;
      min-height: 100vh;
    }

    h1 {
      font-size: 4em;
      font-family: "Ga Maamli", sans-serif;
      font-weight: 400;
      font-style: normal;
      color: #191818e0;
      text-align: center;
      margin: 0;
    }

    h2 {
      margin: 0;
      font-weight: normal;
      color: #111827;
      font-size: 20px;
      text-align: center;
    }

    p {
      color: #111827;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.006em;
      margin: 1.5em 0;
    }

    img {
      width: 30vw;
    }

    a,
    a:visited,
    a:active {
      color: #474747d0;
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 5px;
      font-family: monospace;
    }

    a:hover {
      color: rgba(255, 255, 255);
    }

    .info {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      justify-content: center;
      gap: 6em;
      padding: 1em 7em 1em 5em;
    }

    .direccion {
      text-align: center;
      font-size: 0.8em;
      line-height: 0.5em;
      margin: 0.7em;
    }

    .boton {
      color: #474747d0;
      text-decoration: none;
      background: #eef4ce84;
      padding: 6px 6px;
      border-radius: 5px;
      font-family: system-ui;
      font-size: 0.6em;
      position: fixed;
      bottom: 3vh;
      right: 2vw;
      box-shadow: 2px 2px 2px #242424c9;
    }

    #contenedorAV {
      display: flex;
      justify-content: center;
      margin-top: 2em;
      border-top: 1px dashed #000;
      padding-top: 2em;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 2em;

      img {
        width: 20%;
        height: auto;
      }

      .video {
        width: 40%;
        height: auto;
        aspect-ratio: 16/9;
      }
    }

    #contenedorPapeles {
      margin-top: 2em;
      border-top: 1px dashed #000;
      padding: 2em 6em;
    }

    @media screen and (max-width: 450px) {
      h1 {
        margin-top: 0px;
      }
      img {
        height: 70vh;
        width: auto;
      }
      .container {
        padding: 3em;
        width: 100vw;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        justify-content: center;
        gap: 2em;
        padding: 0em;
      }

      #contenedorAV {
        img {
          width: 40%;
        }
      }
    }

    @media screen and (min-width: 450px) and (max-width: 1100px) {
      h1 {
        margin-top: 0px;
      }
      img {
        height: 80vh;
        width: auto;
      }
      .info {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        justify-content: center;
        gap: 2em;
        padding: 0em 2em;
      }
      #contenedorAV {
        img {
          width: 32%;
        }
      }
    }
  </style>
</Layout>
