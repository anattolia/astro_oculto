---
export interface Props {
  // container: string
  // accesstoken: string
  /** If `false`, the map will not respond to interaction.  This is a static map built with the full web map rendering API. */
  //interactive?: boolean
  // containerstyle?: string
}

// const { zoom, mapstyle, container, accesstoken, interactive, containerstyle = "height: 61.8vh"} = Astro.props
---

<div class="mapbox-map" id="map"></div>

<script>
  import mapboxgl from "mapbox-gl";
  import "mapbox-gl/dist/mapbox-gl.css";

  import ic_1 from "../assets/iconos/1.png";
  import ic_graba from "../assets/iconos/cassette.png";

  const iconos = [ic_1.src, ic_graba.src];

  mapboxgl.accessToken =
    "pk.eyJ1IjoiYW5hdHRvbGFpIiwiYSI6InR5R3U4MmsifQ.rM6ZPt6QHPuMGAAOHFM4RQ";

  const long = -74.1021;
  const lat = 4.64;

  // Importar lista de lugares
  import { lugares } from "../data/lugares.js";

  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/anattolai/ck0gp1c513qdx1co0u9v4f3lk",
    center: [long, lat],
    zoom: 11.0,
    dragPan: true,
  });

  // Esperar a que Mapbox cargue por completo antes de agregar marcadores
  map.on("load", () => {
    for (const marker of lugares.features) {
      const el = document.createElement("div");
      const width = marker.properties.iconSize[0];
      const height = marker.properties.iconSize[1];

      el.classList.add("marker");

      el.style.width = `${width}px`;
      el.style.height = `${height}px`;
      el.style.backgroundImage = `url('${iconos[marker.properties.icono]}')`;
      el.style.backgroundSize = "contain"; // Asegura que cubra todo el div circular
      el.style.backgroundRepeat = "no-repeat";
      el.style.backgroundPosition = "center";

      el.tabIndex = 0;
      // el.ariaLabel = `Marker with image of the ${marker.properties.nombre}`;

      el.addEventListener("click", () => {
        //  window.alert(marker.properties.nombre);
      });

      const popup = new mapboxgl.Popup().setHTML(
        `<strong>${marker.properties.elegido ? `<a href= ../${marker.properties.nombre.toLowerCase()}>${marker.properties.nombre}</a>` : `<p>${marker.properties.nombre}</p>`} </strong><p>${marker.properties.añoInicio} - ${marker.properties.añoFin}<br>${marker.properties.direccion}<br></p>`,
      );

      new mapboxgl.Marker(el)
        .setLngLat(marker.geometry.coordinates)
        .setPopup(popup)
        .addTo(map);
    }
  });
</script>

<style>
  #map {
    width: 98%;
    height: 98%;
    display: block;
    position: absolute;
    top: 1%;
    left: 1%;
  }

  :global(.marker) {
    display: block;
    border: none;
    cursor: pointer;
    padding: 0;
  }
</style>
