---
export interface Props {
  // container: string
  // accesstoken: string
  /** If `false`, the map will not respond to interaction.  This is a static map built with the full web map rendering API. */
  //interactive?: boolean
  // containerstyle?: string
}

// const { zoom, mapstyle, container, accesstoken, interactive, containerstyle = "height: 61.8vh"} = Astro.props
---

<a id="inicio" href="../">Inicio</a>
<div class="mapbox-map" id="map"></div>

<script>
  import mapboxgl from "mapbox-gl";
  import "mapbox-gl/dist/mapbox-gl.css";

  import ic_rock from "../assets/iconos/rockPunk.png"; // 1. rock
  import ic_baila from "../assets/iconos/1.png"; // 2. bailable
  import ic_graba from "../assets/iconos/cassette.png"; // 3. hip hop
  import ic_gay from "../assets/iconos/queer.png"; // 4 gay
  import ic_electro from "../assets/iconos/electro.png"; // 5 electrónica

  const iconos = [
    ic_rock.src,
    ic_baila.src,
    ic_graba.src,
    ic_electro.src,
    ic_gay.src,
  ];

  mapboxgl.accessToken =
    "pk.eyJ1IjoiYW5hdHRvbGFpIiwiYSI6InR5R3U4MmsifQ.rM6ZPt6QHPuMGAAOHFM4RQ";

  const long = -74.1021;
  const lat = 4.64;

  // Importar lista de lugares
  import { lugares } from "../data/lugares.js";

  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/anattolai/ck0gp1c513qdx1co0u9v4f3lk",
    center: [long, lat],
    zoom: 11.0,
    dragPan: true,
  });

  // Esperar a que Mapbox cargue por completo antes de agregar marcadores
  map.on("load", () => {
    for (const marker of lugares.features) {
      const el = document.createElement("div");
      const width = marker.properties.iconSize[0];
      const height = marker.properties.iconSize[1];

      el.classList.add("marker");

      if (marker.properties.elegido) {
        // Cambiar color de borde a lugares con micrositio
        el.style.border = "2px solid #7ead7c"; //rgb(255 127 127)";
      } else {
        el.style.border = "1px solid black";
      }

      el.style.width = `${width}px`;
      el.style.height = `${height}px`;
      el.style.backgroundImage = `url('${iconos[marker.properties.icono - 1]}')`;
      el.style.backgroundSize = "contain"; // Asegura que cubra todo el div circular
      el.style.backgroundRepeat = "no-repeat";
      el.style.backgroundPosition = "center";

      el.tabIndex = 0;
      // el.ariaLabel = `Marker with image of the ${marker.properties.nombre}`;

      el.addEventListener("click", () => {
        //  window.alert(marker.properties.nombre);
      });

      let enlaceLugar = marker.properties.nombre
        .toLowerCase()
        .replace(/ /g, "_")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

      const popup = new mapboxgl.Popup().setHTML(
        `<strong>${marker.properties.elegido ? `<a href= ../${enlaceLugar}>${marker.properties.nombre}</a>` : `<p>${marker.properties.nombre}</p>`} 
          </strong><p>${marker.properties.añoInicio} - ${marker.properties.añoFin}
            <br>${marker.properties.genero}
            <br>${marker.properties.direccion}
            <br>${marker.properties.barrio}, ${marker.properties.localidad}</p>
            <p>${marker.properties.descripcion}</p>
            <p>Causa del cierre: ${marker.properties.causaCierre}</p>`,
      );

      new mapboxgl.Marker(el)
        .setLngLat(marker.geometry.coordinates)
        .setPopup(popup)
        .addTo(map);
    }
  });
</script>

<style>
  #inicio {
    position: absolute;
    top: 10px;
    left: 20px;
    z-index: 9999;
    color: #474747d0;
    text-decoration: none;
    background: #efe2da;
    padding: 2px 8px;
    border-radius: 5px;
    font-family: system-ui;
    box-shadow: 2px 2px 2px #242424c9;
  }
  #inicio:hover {
    color: #c8c0b6;
    background: rgba(255, 255, 255);
  }
  #map {
    width: 98%;
    height: 98%;
    display: block;
    position: absolute;
    top: 1%;
    left: 1%;
  }

  :global(a, a:visited, a:active) {
    color: #8590e0;
    text-decoration: none;
  }

  :global(.marker) {
    display: block;
    border: 1px black solid;
    cursor: pointer;
    padding: 0;
    background-color: #d2d5edb5; /*#eecfe5b5;*/
    border-radius: 50%;
  }

  :global(.marker:hover) {
    display: block;
    border: 1px black solid;
    cursor: pointer;
    padding: 0;
    background-color: #eed9cfb5;
    border-radius: 50%;
  }
  :global(.mapboxgl-popup) {
    max-width: 30vw;
    font-family: system-ui;
    text-align: center;
    background-color: #d2d5edb5;
    padding: 1em 1.5em;
    overflow: auto;
  }
</style>
